<?xml version="1.0"?>
<package format="3">
  <name>piracer_state_manager</name>
  <version>0.1.0</version>
  <description>Detector-driven behavior state publisher for PiRacer.</description>
  <maintainer email="adrian@example.com">Adrian</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rtabmap_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>piracer_navigation</exec_depend>
  <exec_depend>piracer_search</exec_depend>
  <exec_depend>robot_perception</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
