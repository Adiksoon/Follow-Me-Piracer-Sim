<?xml version="1.0"?>
<!--
  Derived from PiRacer-Gazebo-Simulation by Sujong Ha (MIT), commit
  db9f49c85e4417ec3566d0d87702f49febbd3ee1.  See README.md in this package.
-->
<robot name="piracer" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Simulation-only RGB-D camera for the author-requested VO visibility trial:
    339 mm above floor, 320 mm above base_link at the default 19 mm spawn,
    at the modeled front edge (x=236 mm), level at zero pitch.
    Position is retained from CAM-MOUNT-01; its former h339_x000_a20 setting
    used 20 degrees downward for suitcase detection. The level setting is a
    new author choice, not a study result or a measured physical OAK-D mount.
  -->
  <xacro:arg name="include_camera" default="false"/>
  <!-- SYMULACJA_RGBD_PROTOTYPE_V1: 16:9 raster scaled from the unit's factory RGB calibration raster. -->
  <xacro:arg name="camera_x" default="0.236"/>
  <xacro:arg name="camera_y" default="0.0"/>
  <xacro:arg name="camera_z" default="0.320"/>
  <xacro:arg name="camera_roll" default="0.0"/>
  <xacro:arg name="camera_pitch" default="0.0"/>
  <xacro:arg name="camera_yaw" default="0.0"/>
  <xacro:arg name="camera_width" default="640"/>
  <xacro:arg name="camera_height" default="360"/>
  <xacro:arg name="camera_horizontal_fov" default="1.14075"/>
  <xacro:arg name="camera_update_rate" default="30.0"/>
  <xacro:arg name="camera_clip_near" default="0.05"/>
  <xacro:arg name="camera_clip_far" default="20.0"/>
  <xacro:arg name="camera_k1" default="0.0"/>
  <xacro:arg name="camera_k2" default="0.0"/>
  <xacro:arg name="camera_k3" default="0.0"/>
  <xacro:arg name="camera_p1" default="0.0"/>
  <xacro:arg name="camera_p2" default="0.0"/>
  <xacro:arg name="camera_center_x" default="0.5"/>
  <xacro:arg name="camera_center_y" default="0.5"/>

  <!-- Root vehicle frame used by the project ROS2 interface contract. -->
  <link name="base_link"></link>

  <!-- LINK: chassis -->
  <link name="chassis">
    <pose>0 0 0 0 0 0</pose>

    <inertial>
      <mass value="0.715774"/>
      <origin xyz="0.118 0 0.021" rpy="0 0 0"/>
      <inertia ixx="0.00111327" ixy="0" ixz="0" iyy="0.00342736" iyz="0" izz="0.00433019"/>
    </inertial>

    <collision name="chassis_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/chassis.stl"/>
      </geometry>
    </collision>

    <visual name="chassis_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/chassis.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: main_steer -->
  <link name="main_steer">
    <pose>0 0 0 0 0 0</pose>

    <inertial>
      <mass value="0.008482"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="2.82733e-07" ixy="0" ixz="0" iyy="2.82733e-07" iyz="0" izz="4.241e-07"/>
    </inertial>

    <collision name="main_steer_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.010" radius="0.010"/>
      </geometry>
    </collision>

    <visual name="main_steer_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.010" radius="0.010"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: left_steer -->
  <link name="left_steer">
    <pose>0 0 0 0 0 0</pose>

    <!-- Approximate hub/knuckle assembly, not just the visible 2 mm shaft.
         Simulation estimate, not a measured PiRacer part. The former 0.746 g
         shaft had Izz=1.492e-9 between the chassis and a 68.563 g wheel,
         creating a large inertia ratio across the ODE constraints. -->
    <inertial>
      <mass value="0.010"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>

    <collision name="left_steer_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.022" radius="0.002"/>
      </geometry>
    </collision>

    <visual name="left_steer_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.022" radius="0.002"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: right_steer -->
  <link name="right_steer">
    <pose>0 0 0 0 0 0</pose>

    <!-- Same approximate hub/knuckle inertia as the left side. -->
    <inertial>
      <mass value="0.010"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>

    <collision name="right_steer_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.022" radius="0.002"/>
      </geometry>
    </collision>

    <visual name="right_steer_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.022" radius="0.002"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: board -->
  <link name="board">
    <pose>0 0 0 0 0 0</pose>

    <collision name="board_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/board.stl"/>
      </geometry>
    </collision>

    <visual name="board_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/board.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: rpi -->
  <link name="rpi">
    <pose>0 0 0 0 0 0</pose>

    <collision name="rpi_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/rpi.stl"/>
      </geometry>
    </collision>

    <visual name="rpi_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/rpi.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: motor1 -->
  <link name="motor1">
    <pose>0 0 0 0 0 0</pose>

    <collision name="motor1_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/motor.stl"/>
      </geometry>
    </collision>

    <visual name="motor1_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/motor.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: motor2 -->
  <link name="motor2">
    <pose>0 0 0 0 0 0</pose>

    <collision name="motor2_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/motor.stl"/>
      </geometry>
    </collision>

    <visual name="motor2_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/motor.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: cover -->
  <link name="cover">
    <pose>0 0 0 0 0 0</pose>

    <collision name="cover_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/cover.stl"/>
      </geometry>
    </collision>

    <visual name="cover_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/cover.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: rear_left_tire -->
  <link name="rear_left_tire">
    <pose>0 0 0 0 0 0</pose>

    <inertial>
      <mass value="0.068563"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="2.36771e-05" ixy="0" ixz="0" iyy="2.36771e-05" iyz="0" izz="3.96294e-05"/>
    </inertial>

    <collision name="rear_left_tire_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.026" radius="0.034"/>
      </geometry>
    </collision>

    <visual name="rear_left_tire_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/tire.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: rear_left_disk -->
  <link name="rear_left_disk">
    <pose>0 0 0 0 0 0</pose>

    <collision name="rear_left_disk_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/disk.stl"/>
      </geometry>
    </collision>

    <visual name="rear_left_disk_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/disk.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: rear_right_tire -->
  <link name="rear_right_tire">
    <pose>0 0 0 0 0 0</pose>

    <inertial>
      <mass value="0.068563"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="2.36771e-05" ixy="0" ixz="0" iyy="2.36771e-05" iyz="0" izz="3.96294e-05"/>
    </inertial>

    <collision name="rear_right_tire_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.026" radius="0.034"/>
      </geometry>
    </collision>

    <visual name="rear_right_tire_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/tire.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: rear_right_disk -->
  <link name="rear_right_disk">
    <pose>0 0 0 0 0 0</pose>

    <collision name="rear_right_disk_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/disk.stl"/>
      </geometry>
    </collision>

    <visual name="rear_right_disk_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/disk.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: front_left_tire -->
  <link name="front_left_tire">
    <pose>0 0 0 0 0 0</pose>

    <inertial>
      <mass value="0.068563"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="2.36771e-05" ixy="0" ixz="0" iyy="2.36771e-05" iyz="0" izz="3.96294e-05"/>
    </inertial>

    <collision name="front_left_tire_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.026" radius="0.034"/>
      </geometry>
    </collision>

    <visual name="front_left_tire_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/tire.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: front_left_disk -->
  <link name="front_left_disk">
    <pose>0 0 0 0 0 0</pose>

    <collision name="front_left_disk_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/disk.stl"/>
      </geometry>
    </collision>

    <visual name="front_left_disk_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/disk.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: front_right_tire -->
  <link name="front_right_tire">
    <pose>0 0 0 0 0 0</pose>

    <inertial>
      <mass value="0.068563"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="2.36771e-05" ixy="0" ixz="0" iyy="2.36771e-05" iyz="0" izz="3.96294e-05"/>
    </inertial>

    <collision name="front_right_tire_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.026" radius="0.034"/>
      </geometry>
    </collision>

    <visual name="front_right_tire_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/tire.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- LINK: front_right_disk -->
  <link name="front_right_disk">
    <pose>0 0 0 0 0 0</pose>

    <collision name="front_right_disk_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/disk.stl"/>
      </geometry>
    </collision>

    <visual name="front_right_disk_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh scale="0.001 0.001 0.001" filename="package://robot_description/meshes/disk.stl"/>
      </geometry>
    </visual>
  </link>

  <xacro:if value="$(arg include_camera)">
  <!-- LINK: temporary simulation RGB-D camera. -->
  <link name='sim_camera_link'>
    <pose>0 0 0 0 0 0</pose>

    <collision name='camera_collision'>
      <origin xyz="0 0 0" rpy=" 0 0 0"/>
      <geometry>
        <box size=".001 .001 .001"/>
      </geometry>
    </collision>

    <visual name='camera_visual'>
      <origin xyz="0 0 0" rpy=" 0 0 0"/>
      <geometry>
        <box size=".001 .001 .001"/>
      </geometry>
    </visual>
  </link>
  <link name='sim_camera_optical_frame'/>
  </xacro:if>

  <!-- COLOR: chassis -->
  <gazebo reference="chassis">
    <material>Gazebo/Green</material>
  </gazebo>

  <!-- COLOR: main_steer -->
  <gazebo reference="main_steer">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- COLOR: left_steer -->
  <gazebo reference="left_steer">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- COLOR: right_steer -->
  <gazebo reference="right_steer">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- COLOR: board -->
  <gazebo reference="board">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- COLOR: rpi -->
  <gazebo reference="rpi">
    <material>Gazebo/GreenTransparent</material>
  </gazebo>

  <!-- COLOR: motor1 -->
  <gazebo reference="motor1">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- COLOR: motor2 -->
  <gazebo reference="motor2">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- COLOR: cover -->
  <gazebo reference="cover">
    <material>Gazebo/GreenGlow</material>
  </gazebo>

  <!-- COLOR: rear_left_tire -->
  <gazebo reference="rear_left_tire">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- COLOR: rear_left_disk -->
  <gazebo reference="rear_left_disk">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- COLOR: rear_right_tire -->
  <gazebo reference="rear_right_tire">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- COLOR: rear_right_disk -->
  <gazebo reference="rear_right_disk">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- COLOR: front_left_tire -->
  <gazebo reference="front_left_tire">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- COLOR: front_left_disk -->
  <gazebo reference="front_left_disk">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- COLOR: front_right_tire -->
  <gazebo reference="front_right_tire">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- COLOR: front_right_disk -->
  <gazebo reference="front_right_disk">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- JOINT: chassis -->
  <joint name="chassis_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="chassis"/>
  </joint>

  <!-- JOINT: main_steer -->
  <joint name="main_steer_joint" type="continuous">
    <origin xyz="0.170 0 0.013" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="main_steer"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
    <limit effort="10000" velocity="1000"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- JOINT: left_steer -->
  <joint name="left_steer_joint" type="revolute">
    <origin xyz="0.179 0.060 0.013" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="left_steer"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
    <limit lower="-0.7853981633974483" upper="0.7853981633974483" effort="10000" velocity="1000"/>
    <dynamics damping="0.001" friction="0.0"/>
  </joint>

  <!-- JOINT: right_steer -->
  <joint name="right_steer_joint" type="revolute">
    <origin xyz="0.179 -0.060 0.013" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="right_steer"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
    <limit lower="-0.7853981633974483" upper="0.7853981633974483" effort="10000" velocity="1000"/>
    <dynamics damping="0.001" friction="0.0"/>
  </joint>

  <!-- ODE integrates steering damping implicitly. For the existing P=0.0064
       and estimated wheel+knuckle yaw inertia 3.81e-5 kg m^2, critical damping
       is about 0.001 N m s/rad. This is a starting estimate, not a LIVE result.
       MuJoCo armature and servo/contact parameters are not transferred. -->
  <gazebo reference="left_steer_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="right_steer_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>

  <!-- JOINT: board -->
  <joint name="board_joint" type="fixed">
    <origin xyz="0.045 0 0.002" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="board"/>
  </joint>

  <!-- JOINT: rpi -->
  <joint name="rpi_joint" type="fixed">
    <origin xyz="0.035 0 0.027" rpy="0 0 0"/>
    <parent link="board"/>
    <child link="rpi"/>
  </joint>

  <!-- JOINT: motor1 -->
  <joint name="motor1_joint" type="fixed">
    <origin xyz="0.024 0.047 0.023" rpy="1.570796 0 0"/>
    <parent link="chassis"/>
    <child link="motor1"/>
  </joint>

  <!-- JOINT: motor2 -->
  <joint name="motor2_joint" type="fixed">
    <origin xyz="0.024 -0.047 0.023" rpy="1.570796 0 0"/>
    <parent link="chassis"/>
    <child link="motor2"/>
  </joint>

  <!-- JOINT: cover -->
  <joint name="cover_joint" type="fixed">
    <origin xyz="0.024 0 0.023" rpy="1.570796 0 0"/>
    <parent link="chassis"/>
    <child link="cover"/>
  </joint>

  <!-- JOINT: rear_left_tire -->
  <joint name="rear_left_tire_joint" type="continuous">
    <origin xyz="0.024 0.0855 0.015" rpy="-1.570796 0 0"/>
    <parent link="chassis"/>
    <child link="rear_left_tire"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
    <limit effort="10000" velocity="1000"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- JOINT: rear_left_disk -->
  <joint name="rear_left_disk_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-3.141592 0 0"/>
    <parent link="rear_left_tire"/>
    <child link="rear_left_disk"/>
  </joint>

  <!-- JOINT: rear_right_tire -->
  <joint name="rear_right_tire_joint" type="continuous">
    <origin xyz="0.024 -0.0855 0.015" rpy="-1.570796 0 0"/>
    <parent link="chassis"/>
    <child link="rear_right_tire"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
    <limit effort="10000" velocity="1000"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- JOINT: rear_right_disk -->
  <joint name="rear_right_disk_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="rear_right_tire"/>
    <child link="rear_right_disk"/>
  </joint>

  <!-- JOINT: front_left_tire -->
  <joint name="front_left_tire_joint" type="continuous">
    <origin xyz="0 0.014 0.002" rpy="1.570796 0 0"/>
    <parent link="left_steer"/>
    <child link="front_left_tire"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
    <limit effort="10000" velocity="1000"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- JOINT: front_left_disk -->
  <joint name="front_left_disk_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-3.141592 0 0"/>
    <parent link="front_left_tire"/>
    <child link="front_left_disk"/>
  </joint>

  <!-- JOINT: front_right_tire -->
  <joint name="front_right_tire_joint" type="continuous">
    <origin xyz="0 -0.014 0.002" rpy="1.570796 0 0"/>
    <parent link="right_steer"/>
    <child link="front_right_tire"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
    <limit effort="10000" velocity="1000"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- JOINT: front_right_disk -->
  <joint name="front_right_disk_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="front_right_tire"/>
    <child link="front_right_disk"/>
  </joint>

  <xacro:if value="$(arg include_camera)">
  <!-- JOINT: temporary upstream camera; disabled by default. -->
  <joint name="sim_camera_joint" type="fixed">
    <origin xyz="$(arg camera_x) $(arg camera_y) $(arg camera_z)" rpy="$(arg camera_roll) $(arg camera_pitch) $(arg camera_yaw)"/>
    <parent link="chassis"/>
    <child link="sim_camera_link"/>
  </joint>
  <!-- Standard ROS optical convention: z forward, x right, y down. -->
  <joint name="sim_camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
    <parent link="sim_camera_link"/>
    <child link="sim_camera_optical_frame"/>
  </joint>
  </xacro:if>

  <!--
    PLUGIN: upstream ROS Humble GazeboRosAckermannDrive 3.9.0.
    Drive P=0.0155 is an experimental low-speed response candidate.
    Steering PID values remain provisional starting estimates.
    The upstream plugin changes the world friction model to cone_model on load.
  -->
  <gazebo>
    <plugin name="gazebo_ros_ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
      <ros>
        <namespace>/piracer</namespace>
        <remapping>cmd_vel:=ackermann_cmd_vel</remapping>
      </ros>
      <update_rate>100.0</update_rate>
      <front_left_joint>front_left_tire_joint</front_left_joint>
      <front_right_joint>front_right_tire_joint</front_right_joint>
      <rear_left_joint>rear_left_tire_joint</rear_left_joint>
      <rear_right_joint>rear_right_tire_joint</rear_right_joint>
      <left_steering_joint>left_steer_joint</left_steering_joint>
      <right_steering_joint>right_steer_joint</right_steering_joint>
      <max_speed>0.20</max_speed>
      <max_steer>0.554</max_steer>
      <left_steering_pid_gain>0.0064 0 0</left_steering_pid_gain>
      <left_steering_i_range>0 0</left_steering_i_range>
      <right_steering_pid_gain>0.0064 0 0</right_steering_pid_gain>
      <right_steering_i_range>0 0</right_steering_i_range>
      <linear_velocity_pid_gain>0.0155 0 0</linear_velocity_pid_gain>
      <linear_velocity_i_range>0 0</linear_velocity_i_range>
      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <publish_distance>false</publish_distance>
      <publish_steerangle>false</publish_steerangle>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
    <!-- Feed actual Gazebo joint positions to robot_state_publisher. Keep
         wheel TF publication disabled in the drive plugin so each link
         transform has one owner: robot_state_publisher. -->
    <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>100.0</update_rate>
      <joint_name>main_steer_joint</joint_name>
      <joint_name>left_steer_joint</joint_name>
      <joint_name>right_steer_joint</joint_name>
      <joint_name>rear_left_tire_joint</joint_name>
      <joint_name>rear_right_tire_joint</joint_name>
      <joint_name>front_left_tire_joint</joint_name>
      <joint_name>front_right_tire_joint</joint_name>
    </plugin>
  </gazebo>

  <xacro:if value="$(arg include_camera)">
  <!-- Provisional Gazebo RGB-D approximation; depth is ideal render geometry, not OAK stereo. -->
  <gazebo reference="sim_camera_link">
    <sensor type="depth" name="sim_camera_sensor">
      <visualize>false</visualize>
      <update_rate>$(arg camera_update_rate)</update_rate>
      <always_on>1</always_on>

      <camera name="sim_camera">
        <horizontal_fov>$(arg camera_horizontal_fov)</horizontal_fov>
        <image>
          <width>$(arg camera_width)</width>
          <height>$(arg camera_height)</height>
          <format>R8G8B8</format>
        </image>
        <depth_camera/>
        <clip>
          <near>$(arg camera_clip_near)</near>
          <far>$(arg camera_clip_far)</far>
        </clip>
        <distortion>
          <k1>$(arg camera_k1)</k1>
          <k2>$(arg camera_k2)</k2>
          <k3>$(arg camera_k3)</k3>
          <p1>$(arg camera_p1)</p1>
          <p2>$(arg camera_p2)</p2>
          <center>$(arg camera_center_x) $(arg camera_center_y)</center>
        </distortion>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/sim_camera</namespace>
          <remapping>sim_camera/image_raw:=color/image_raw</remapping>
          <remapping>sim_camera/camera_info:=color/camera_info</remapping>
          <remapping>sim_camera/depth/image_raw:=depth/image_raw</remapping>
          <remapping>sim_camera/depth/camera_info:=depth/camera_info</remapping>
        </ros>
        <camera_name>sim_camera</camera_name>
        <frame_name>sim_camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  </xacro:if>
</robot>
