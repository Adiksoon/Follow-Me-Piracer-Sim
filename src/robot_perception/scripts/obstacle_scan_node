#!/usr/bin/env python3
"""Publish height-filtered depth geometry for FOLLOW and Nav2."""

import rclpy
from cv_bridge import CvBridge
from message_filters import Subscriber, TimeSynchronizer
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from rclpy.time import Time
from sensor_msgs.msg import CameraInfo, Image, LaserScan
from tf2_ros import Buffer, TransformException, TransformListener

from robot_perception.obstacle_scan import depth_obstacle_scan


class ObstacleScanNode(Node):
    def __init__(self):
        super().__init__("obstacle_scan_node")
        self.declare_parameter("min_height", .03)
        self.declare_parameter("max_height", .5)
        self._bridge = CvBridge()
        self._buffer = Buffer()
        self._listener = TransformListener(self._buffer, self)
        self._publisher = self.create_publisher(
            LaserScan, "/piracer/obstacle_scan", qos_profile_sensor_data)
        self._depth = Subscriber(self, Image, "/sim_camera/depth/image_raw",
                                 qos_profile=qos_profile_sensor_data)
        self._info = Subscriber(self, CameraInfo, "/sim_camera/depth/camera_info",
                                qos_profile=qos_profile_sensor_data)
        self._sync = TimeSynchronizer([self._depth, self._info], 10)
        self._sync.registerCallback(self._on_depth)

    def _on_depth(self, image, info):
        try:
            transform = self._buffer.lookup_transform(
                "base_link", image.header.frame_id, Time.from_msg(image.header.stamp))
            scan = depth_obstacle_scan(
                image, info, transform, self._bridge,
                float(self.get_parameter("min_height").value),
                float(self.get_parameter("max_height").value))
        except (TransformException, ValueError, TypeError) as error:
            self.get_logger().warning(str(error), throttle_duration_sec=5.)
            return  # No fresh scan means STOP through FOLLOW's existing age check.
        self._publisher.publish(scan)


def main(args=None):
    rclpy.init(args=args)
    node = ObstacleScanNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
