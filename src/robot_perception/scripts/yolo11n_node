#!/usr/bin/env python3
"""ROS 2 node for CPU inference with the project's YOLO11n ONNX model."""

import rclpy
from cv_bridge import CvBridge
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import Image
from vision_msgs.msg import Detection2DArray

from robot_perception.opencv_dnn import OpenCVDNNDetector
from robot_perception.ros_messages import image_message_to_rgb, publish_outputs


def parse_suitcase_filter(value: str) -> set[int]:
    """Resolve suitcase in COCO or the single-class fine-tuned export."""
    normalized = value.strip().lower()
    if normalized in ("", "suitcase", "28"):
        return {28}
    if normalized == "0":
        return {0}
    raise ValueError("class_filter must be empty, 'suitcase', '28', or '0'")


class Yolo11nNode(Node):
    """Subscribe to RGB frames and publish suitcase detections plus overlay."""

    def __init__(self) -> None:
        super().__init__("yolo11n_node")
        self.declare_parameter("image_topic", "/piracer/sim_camera/color/image_raw")
        self.declare_parameter("model_path", "")
        self.declare_parameter("backend", "opencv_dnn")
        self.declare_parameter("confidence", 0.35)
        self.declare_parameter("nms_iou", 0.5)
        self.declare_parameter("imgsz", 640)
        self.declare_parameter("class_filter", "suitcase")
        self.declare_parameter("opencv_num_threads", 1)
        self.declare_parameter("torch_num_threads", 1)
        self.declare_parameter("detection_topic", "/piracer/yolo/detections")
        self.declare_parameter("debug_image_topic", "/piracer/yolo/debug_image")

        backend = str(self.get_parameter("backend").value)
        if backend != "opencv_dnn":
            raise ValueError(f"unsupported YOLO11n backend: {backend!r}")

        self._bridge = CvBridge()
        class_filter = parse_suitcase_filter(
            str(self.get_parameter("class_filter").value)
        )
        self._detector = OpenCVDNNDetector(
            model_path=str(self.get_parameter("model_path").value),
            input_size=int(self.get_parameter("imgsz").value),
            confidence_threshold=float(self.get_parameter("confidence").value),
            nms_iou=float(self.get_parameter("nms_iou").value),
            class_filter=class_filter,
            num_threads=int(self.get_parameter("opencv_num_threads").value),
        )

        detection_topic = str(self.get_parameter("detection_topic").value)
        debug_image_topic = str(self.get_parameter("debug_image_topic").value)
        self._detection_publisher = self.create_publisher(
            Detection2DArray, detection_topic, 10
        )
        self._debug_image_publisher = self.create_publisher(Image, debug_image_topic, 10)
        image_topic = str(self.get_parameter("image_topic").value)
        self._image_subscription = self.create_subscription(
            Image,
            image_topic,
            self._on_image,
            qos_profile_sensor_data,
        )
        self.get_logger().info(
            "Loaded YOLO11n ONNX with OpenCV DNN CPU; "
            f"input=1x3x{int(self.get_parameter('imgsz').value)}x"
            f"{int(self.get_parameter('imgsz').value)}, "
            f"confidence={float(self.get_parameter('confidence').value):.2f}, "
            f"class=suitcase({','.join(str(class_id) for class_id in sorted(class_filter))})"
        )

    def _on_image(self, image_message: Image) -> None:
        image_rgb = image_message_to_rgb(image_message, self._bridge)
        detections = self._detector.infer_rgb(image_rgb)
        publish_outputs(
            self._detection_publisher,
            self._debug_image_publisher,
            image_message,
            image_rgb,
            detections,
            self._bridge,
        )


def main(args=None) -> None:
    rclpy.init(args=args)
    node = None
    try:
        node = Yolo11nNode()
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if node is not None:
            node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
