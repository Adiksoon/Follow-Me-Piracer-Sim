#!/usr/bin/env python3
"""Fail-closed ROS entry point while YOLO11n model licensing is unresolved."""

import rclpy
from rclpy.node import Node


class Yolo11nNode(Node):
    """Declare the canonical launch interface, but do not load model files."""

    def __init__(self) -> None:
        super().__init__("yolo11n_node")
        self.declare_parameter("image_topic", "/piracer/sim_camera/color/image_raw")
        self.declare_parameter("model_path", "")
        self.declare_parameter("backend", "opencv_dnn")
        self.declare_parameter("confidence", 0.35)
        self.declare_parameter("nms_iou", 0.5)
        self.declare_parameter("imgsz", 640)
        self.declare_parameter("class_filter", "suitcase")
        self.declare_parameter("opencv_num_threads", 1)
        self.declare_parameter("torch_num_threads", 1)
        self.get_logger().fatal(
            "YOLO11n is disabled in CP-00D: weight-license integration is not "
            "approved. No model path is opened, and no image subscription or "
            "detection/debug publisher is created."
        )


def main(args=None) -> int:
    rclpy.init(args=args)
    node = Yolo11nNode()
    node.destroy_node()
    rclpy.shutdown()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
