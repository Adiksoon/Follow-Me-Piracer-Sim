<?xml version="1.0"?>
<sdf version="1.6">
  <model name="dataset_camera">
    <static>false</static>
    <link name="dataset_camera_link">
      <gravity>false</gravity>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="dataset_camera_sensor" type="depth">
        <always_on>true</always_on>
        <update_rate>5.0</update_rate>
        <visualize>false</visualize>
        <camera name="dataset_camera">
          <horizontal_fov>1.14075</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <depth_camera/>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
          <distortion>
            <k1>0</k1>
            <k2>0</k2>
            <k3>0</k3>
            <p1>0</p1>
            <p2>0</p2>
            <center>0.5 0.5</center>
          </distortion>
        </camera>
        <plugin name="dataset_camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/dataset_camera</namespace>
            <remapping>dataset_camera/image_raw:=color/image_raw</remapping>
            <remapping>dataset_camera/camera_info:=color/camera_info</remapping>
            <remapping>dataset_camera/depth/image_raw:=depth/image_raw</remapping>
            <remapping>dataset_camera/depth/camera_info:=depth/camera_info</remapping>
          </ros>
          <camera_name>dataset_camera</camera_name>
          <frame_name>dataset_camera_optical_frame</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
