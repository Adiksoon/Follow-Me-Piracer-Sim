<?xml version="1.0"?>
<sdf version="1.5">
  <world name="room15x15">
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.18 0.18 0.18 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Open-top interior is 15 x 15 m; walls are 3 m tall and 0.2 m thick. -->
    <model name="room_structure">
      <static>true</static>
      <link name="room">
        <collision name="floor_collision">
          <pose>0 0 -0.1 0 0 0</pose>
          <geometry><box><size>15.4 15.4 0.2</size></box></geometry>
        </collision>
        <visual name="floor">
          <pose>0 0 -0.1 0 0 0</pose>
          <geometry><box><size>15.4 15.4 0.2</size></box></geometry>
          <material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.58 0.58 0.58 1</diffuse></material>
        </visual>

        <collision name="north_wall_collision">
          <pose>0 7.6 1.5 0 0 0</pose>
          <geometry><box><size>15.4 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="north_wall">
          <pose>0 7.6 1.5 0 0 0</pose>
          <geometry><box><size>15.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.58 0.58 0.58 1</diffuse></material>
        </visual>
        <collision name="south_wall_collision">
          <pose>0 -7.6 1.5 0 0 0</pose>
          <geometry><box><size>15.4 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="south_wall">
          <pose>0 -7.6 1.5 0 0 0</pose>
          <geometry><box><size>15.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.58 0.58 0.58 1</diffuse></material>
        </visual>
        <collision name="east_wall_collision">
          <pose>7.6 0 1.5 0 0 0</pose>
          <geometry><box><size>0.2 15.4 3.0</size></box></geometry>
        </collision>
        <visual name="east_wall">
          <pose>7.6 0 1.5 0 0 0</pose>
          <geometry><box><size>0.2 15.4 3.0</size></box></geometry>
          <material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.58 0.58 0.58 1</diffuse></material>
        </visual>
        <collision name="west_wall_collision">
          <pose>-7.6 0 1.5 0 0 0</pose>
          <geometry><box><size>0.2 15.4 3.0</size></box></geometry>
        </collision>
        <visual name="west_wall">
          <pose>-7.6 0 1.5 0 0 0</pose>
          <geometry><box><size>0.2 15.4 3.0</size></box></geometry>
          <material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.58 0.58 0.58 1</diffuse></material>
        </visual>

      </link>
    </model>

    <!-- Classroom layout: two columns of seating face north (+Y), with an open central aisle at x=0. -->
    <include><uri>model://wooden_bench</uri><name>bench_front_left</name><pose>-2.4 2.1 0 0 0 3.141592654</pose></include>
    <include><uri>model://wooden_bench</uri><name>bench_front_right</name><pose>2.4 2.1 0 0 0 3.141592654</pose></include>
    <include><uri>model://wooden_bench</uri><name>bench_back_left</name><pose>-2.4 -1.4 0 0 0 3.141592654</pose></include>
    <include><uri>model://wooden_bench</uri><name>bench_back_right</name><pose>2.4 -1.4 0 0 0 3.141592654</pose></include>

    <include><uri>model://wooden_chair</uri><name>chair_front_left_a</name><pose>-2.95 1.3 0 0 0 3.141592654</pose></include>
    <include><uri>model://wooden_chair</uri><name>chair_front_left_b</name><pose>-1.85 1.3 0 0 0 3.141592654</pose></include>
    <include><uri>model://wooden_chair</uri><name>chair_front_right_a</name><pose>1.85 1.3 0 0 0 3.141592654</pose></include>
    <include><uri>model://wooden_chair</uri><name>chair_front_right_b</name><pose>2.95 1.3 0 0 0 3.141592654</pose></include>
    <include><uri>model://wooden_chair</uri><name>chair_back_left_a</name><pose>-2.95 -2.2 0 0 0 3.141592654</pose></include>
    <include><uri>model://wooden_chair</uri><name>chair_back_left_b</name><pose>-1.85 -2.2 0 0 0 3.141592654</pose></include>
    <include><uri>model://wooden_chair</uri><name>chair_back_right_a</name><pose>1.85 -2.2 0 0 0 3.141592654</pose></include>
    <include><uri>model://wooden_chair</uri><name>chair_back_right_b</name><pose>2.95 -2.2 0 0 0 3.141592654</pose></include>

    <!-- Existing CC BY 4.0 suitcase asset with the planar-move controller used in the main repository. -->
    <model name="suitcase_target">
      <static>false</static>
      <pose>3.0 0 0.05 0 0 1.570796327</pose>
      <link name="suitcase_link">
        <inertial>
          <mass>8</mass>
          <inertia><ixx>0.72</ixx><iyy>0.86</iyy><izz>0.30</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="body_collision"><pose>0 0 0.44 0 0 0</pose><geometry><box><size>0.58 0.34 0.98</size></box></geometry></collision>
        <collision name="wheel_collision_fl"><pose>-0.20 -0.13 0.01 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.07</length></cylinder></geometry></collision>
        <collision name="wheel_collision_fr"><pose>-0.20 0.13 0.01 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.07</length></cylinder></geometry></collision>
        <collision name="wheel_collision_rl"><pose>0.20 -0.13 0.01 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.07</length></cylinder></geometry></collision>
        <collision name="wheel_collision_rr"><pose>0.20 0.13 0.01 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.07</length></cylinder></geometry></collision>
        <visual name="suitcase_visual">
          <geometry><mesh><uri>model://sim012_final_suitcase/runtime/suitcase.obj</uri></mesh></geometry>
          <material><ambient>0.75 0.02 0.02 1</ambient><diffuse>0.9 0.03 0.03 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
      <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
        <ros>
          <namespace>/sim012_target</namespace>
          <remapping>cmd_vel:=cmd_vel</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        <update_rate>100</update_rate>
        <publish_rate>20</publish_rate>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
        <odometry_frame>sim012_target_odom</odometry_frame>
        <robot_base_frame>suitcase_link</robot_base_frame>
      </plugin>
    </model>
  </world>
</sdf>
